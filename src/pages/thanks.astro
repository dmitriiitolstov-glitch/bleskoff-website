---
import Header from "../components/Header.astro";
import { defaultSettings } from "../content/defaults";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCmsContent } from "../lib/cms";

const cms = await getCmsContent();
const settings = { ...defaultSettings, ...(cms?.settings ?? {}) };
const phoneHref = String(settings.phone).replace(/[^\d+]/g, "");
const telegramUrl = settings.telegramUrl || "https://t.me/bleskOFF_DS";
---

<BaseLayout
	title="Спасибо за заявку — BleskOFF"
	description="Заявка отправлена. Менеджер BleskOFF свяжется с вами, чтобы уточнить задачу и предложить удобное время."
	canonical="/thanks/"
	noindex={true}
>
	<Header bookingUrl={settings.bookingUrl} />

	<main class="thanks-page">
		<section class="thanks-hero">
			<div class="container thanks-grid">
				<div class="thanks-copy">
					<p class="eyebrow">Заявка отправлена</p>
					<h1>Спасибо.<br /><em>Скоро свяжемся.</em></h1>
					<p>Менеджер BleskOFF изучит заявку, уточнит детали и предложит удобное время для осмотра автомобиля.</p>
					<div class="thanks-actions">
						<a class="button" href={`tel:${phoneHref}`}>Позвонить сейчас</a>
						<a class="button secondary" href={telegramUrl} target="_blank" rel="noreferrer">Написать в Telegram</a>
						<a class="thanks-home" href="/">Вернуться на главную →</a>
					</div>
				</div>

				<ol class="thanks-steps" aria-label="Что произойдёт дальше">
					<li><span>01</span><div><strong>Проверим заявку</strong><p>Менеджер ознакомится с вашими контактами и комментарием.</p></div></li>
					<li><span>02</span><div><strong>Уточним задачу</strong><p>Зададим несколько вопросов об автомобиле и желаемом результате.</p></div></li>
					<li><span>03</span><div><strong>Согласуем визит</strong><p>Предложим время осмотра и заранее обсудим дальнейшие шаги.</p></div></li>
				</ol>
			</div>
		</section>
	</main>

	<footer class="footer">
		<div class="container footer-inner">
			<span>© {new Date().getFullYear()} BleskOFF Detailing Studio</span>
			<span>Санкт-Петербург · {settings.workingHours}</span>
			<a href="https://blesk-off.ru/polit">Политика конфиденциальности</a>
		</div>
	</footer>
</BaseLayout>
