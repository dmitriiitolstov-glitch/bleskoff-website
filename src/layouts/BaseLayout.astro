---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	canonical?: string;
	image?: string;
	noindex?: boolean;
	analytics?: boolean;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title = "BleskOFF — детейлинг и мойка в Санкт-Петербурге",
	description = "Премиальный уход, восстановление и защита автомобиля в Московском районе Санкт-Петербурга.",
	canonical,
	image = "/images/gallery-1.jpg",
	noindex = false,
	analytics = true,
	structuredData,
} = Astro.props;

const site = Astro.site ?? new URL("https://blesk-off.ru");
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, site);
const socialImageUrl = new URL(image, site);
const yandexMetrikaId = import.meta.env.PUBLIC_YANDEX_METRIKA_ID?.trim() || "105879512";
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
		<meta name="theme-color" content="#111111" />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:alt" content="Автомобиль в детейлинг-студии BleskOFF" />
		<meta property="og:site_name" content="BleskOFF" />
		<meta property="og:locale" content="ru_RU" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<title>{title}</title>
		{structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
		{analytics && yandexMetrikaId && (
			<script is:inline define:vars={{ yandexMetrikaId }}>
				(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
				m[i].l=1*new Date();
				for (var j=0;j<document.scripts.length;j++){if(document.scripts[j].src===r){return;}}
				k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
				(window,document,"script","https://mc.yandex.ru/metrika/tag.js?id="+yandexMetrikaId,"ym");

				ym(Number(yandexMetrikaId),"init",{
					ssr:true,
					webvisor:true,
					clickmap:true,
					ecommerce:"dataLayer",
					referrer:document.referrer,
					url:location.href,
					accurateTrackBounce:true,
					trackLinks:true
				});
			</script>
		)}
	</head>
	<body>
		{analytics && yandexMetrikaId && (
			<noscript><div><img src={`https://mc.yandex.ru/watch/${yandexMetrikaId}`} style="position:absolute; left:-9999px;" alt="" /></div></noscript>
		)}
		<slot />
		{analytics && <script src="https://cdn.callibri.ru/callibri.js" type="text/javascript" charset="utf-8" defer></script>}
	</body>
</html>
